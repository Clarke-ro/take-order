{
  "name": "workspace",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent || !process.env.npm_config_user_agent.startsWith('pnpm/')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"@workspace/*\" --if-present run typecheck",
    "dev:web": "pnpm --filter @workspace/take-order run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "build:web": "pnpm --filter @workspace/take-order run build",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "start:api": "pnpm --filter @workspace/api-server run start",
    "heroku-postbuild": "pnpm --filter @workspace/api-server run build",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed:staging": "pnpm --filter @workspace/scripts run seed:staging",
    "db:reset:staging": "pnpm --filter @workspace/scripts run reset:staging",
    "db:simulate-expiry": "pnpm --filter @workspace/scripts run simulate-expiry"
  },
  "packageManager": "pnpm@9.15.0",
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
