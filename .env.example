# ==============================================================================
# TAKE ORDER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development.
# Do NOT commit actual secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
PORT=
NODE_ENV=
# Set to 'staging' to run staging safety-guarded scripts
APP_ENV=

# ------------------------------------------------------------------------------
# BACKEND (API Server — Heroku Config Vars)
# ------------------------------------------------------------------------------
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# RevenueCat Project Secret API Key (server-to-server REST subscriber lookup)
REVENUECAT_SECRET_KEY=
REVENUECAT_API_KEY=
# Webhook authorization Bearer token shared with RevenueCat Dashboard
REVENUECAT_WEBHOOK_SECRET=
ALLOWED_ORIGINS=
FRONTEND_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# ------------------------------------------------------------------------------
# FRONTEND (Client UI — Vercel Environment Variables)
# ------------------------------------------------------------------------------
# In Vercel, set these with Type = 'Config' (or uncheck 'Sensitive').
# Alternatively, our Vite build bridges prefix-free names (RC_API_KEY, API_URL, CLERK_PUBLISHABLE_KEY) automatically.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
# RevenueCat Public SDK Key (client-side web billing initialization)
VITE_RC_API_KEY=
RC_API_KEY=
VITE_RC_ENTITLEMENT_PRO=
VITE_RC_ENTITLEMENT_PRO_PLUS=
VITE_API_URL=
API_URL=
VITE_API_BASE_URL=
